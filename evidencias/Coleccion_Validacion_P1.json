    {
      "name": "05a - P1-006: Mass Assignment rol ADMIN ignorado (201 con USER)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "pm.test('Rol ADMIN ignorado y fijado a USER sin exponer password', function () {",
              "    const body = pm.response.json();",
              "    pm.expect(body.rol).to.eql('USER');",
              "    pm.expect(body).to.not.have.property('password');",
              "});"
            ]
