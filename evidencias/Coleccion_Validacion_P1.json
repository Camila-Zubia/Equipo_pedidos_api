    "name": "P1 - Validacion Seguridad API (pedidos-api)",
    "description": "Colección de validación post-corrección (retest) para la Práctica 1: Seguridad en APIs (ITSON - Ciberseguridad Aplicada). Verifica mitigaciones de BOLA, BOPLA / Mass Assignment y Validación de datos de entrada (P1-001 a P1-007).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "00 - P1-001: Listar usuarios (sin password)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('No expone el campo password', function () {",
              "    const usuarios = pm.response.json();",
              "    pm.expect(usuarios).to.be.an('array');",
              "    usuarios.forEach(u => {",
              "        pm.expect(u).to.not.have.property('password');",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/usuarios",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "usuarios"
          ]
        },
        "description": "Verifica que GET /api/usuarios devuelva UsuarioRespuestaDTO sin exponer contraseñas (P1-001)."
      }
    },
    {
      "name": "01a - P1-002: Listar pedidos propios (X-User-Id: 2)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Solo devuelve pedidos de Beto sin password', function () {",
              "    const pedidos = pm.response.json();",
              "    pm.expect(pedidos).to.be.an('array');",
              "    pedidos.forEach(p => {",
              "        pm.expect(p.nombreUsuario).to.eql('Beto');",
              "        pm.expect(JSON.stringify(p)).to.not.include('beto12345');",
              "    });",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "2",
            "type": "text"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/pedidos",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "pedidos"
          ]
        },
        "description": "Verifica filtrado de pedidos por usuario autenticado en GET /api/pedidos (P1-002)."
      }
    },
